# Copy to deploy/.env.prod on the hub and fill in. deploy/.env.prod is gitignored.

# Public origin Caddy serves; sign-in links and the OpenRouter callback are built from it.
ORIGIN=https://decide.acb-apps.com

# Resend key for sign-in links. The sender must be on a domain verified in that
# Resend account (acb-apps.com is); otherwise only the account owner gets mail.
RESEND_API_KEY=
MAIL_FROM=DecisionMaker <decide@acb-apps.com>
